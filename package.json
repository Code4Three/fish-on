{
  "name": "fish-on",
  "private": true,
  "version": "1.0.0",
  "description": "Simple app to see optimal fishing times",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tides": "node --env-file=.env src/scripts/buildTides.js",
    "build:sun-moon": "node src/scripts/buildSunMoon.js",
    "build:solunar": "node src/scripts/buildSolunar.js",
    "build:weather": "node src/scripts/buildWeather.js",
    "build:unified": "node src/scripts/buildUnified.js",
    "build:data": "node --env-file=.env src/scripts/buildAll.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Code4Three/fish-on.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Code4Three/fish-on/issues"
  },
  "homepage": "https://github.com/Code4Three/fish-on#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "suncalc": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vitest": "^3.2.4",
    "vite": "^8.2.2"
  }
}
